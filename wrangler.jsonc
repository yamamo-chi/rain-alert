{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rain-alert",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-25",
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"0 22 * * SUN-THU",
			"0 3 * * MON-FRI"
		]
	},
	"vars": {
		"DEBUG_SEND": false,
		"MODELS": "jma_seamless",
		"TIMEZONE": "Asia/Tokyo",
		"CHECK_UNTIL_HOUR": 20
	},
	"upload_source_maps": true
}
